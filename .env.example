# Learnarr needs no environment variables. Everything below is optional;
# see https://learnarr.rushandhurry.us/wiki/configuration.html for what each one does.

# TZ=Europe/Warsaw
# PUBLIC_URL=https://learnarr.example.com
# TRUSTED_ORIGINS=
# MEDIA_SERVER=jellyfin
# MEDIA_SERVER_URL=http://192.168.1.10:8096
# MEDIA_SERVER_TOKEN=
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# OPENSUBTITLES_API_KEY=
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# REMINDER_HOUR=18
